#!/bin/bash

# Split file "Finding.md" into good-looking navigatible HTML

# Clean up old versions
rm -fr sections/
# Use perl; MacOS sed can't handle long lines, and we need to do some
# mild cleanups of Google docs generated markdown first.
# Use pandoc chunk-template so filenames are stable over time.

perl -pe 's/\s*\{#[^}]*\}//g; s/<(data:image\/[^>]+)>/$1/g' Finding.md | \
  pandoc -f markdown+raw_html+pipe_tables+autolink_bare_uris+strikeout \
  -t chunkedhtml --split-level=2 --toc -o sections \
  --template=template.html --chunk-template="%i.html" \
  --css="https://cdn.jsdelivr.net/npm/simpledotcss@2.2.1/simple.min.css" \

echo 'DO NOT EDIT, this is generated' > sections/00_DO_NOT_EDIT
