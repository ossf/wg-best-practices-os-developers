#!/bin/bash
# Clean up Finding.md in place: fixes Google Docs export artifacts
# that trip up markdownlint (see clean-finding.awk). Idempotent. Run
# this right after downloading/exporting Finding.md from Google Docs,
# before committing it.
#
# If Finding.zip (Google Docs' "Web Page (.html, zipped)" download,
# saved here) exists, this also replaces images-originals/ with the
# zip's images, and images/ with the copies we serve (compressed by
# compress-images.py, which needs Pillow), and points Finding.md's
# images at those served copies, sized as in the Google document. Google's markdown export embeds lossy copies of
# the images as base64 "[imageN]: data:..." lines; those get dropped,
# except for images that aren't in the zip (because they have no alt
# text, or Google's HTML export left them out): for those, the
# embedded copy is used, with a warning on stderr so you can fix the
# Google document. Without Finding.zip, images are left as they are.

# SPDX-FileCopyrightText: OpenSSF project contributors
# SPDX-License-Identifier: MIT

set -e
set -o pipefail

zip=Finding.zip
work=",cleanup-tmp.$$"
trap 'rm -rf "$work" Finding.md.new' EXIT
mkdir "$work"

awk_opts=()
if [ -f "$zip" ]; then
  if ! python3 -c 'import PIL' 2>/dev/null; then
    echo 'cleanup-markdown: compress-images.py needs Pillow; on Debian or' >&2
    echo 'Ubuntu, install it with "sudo apt install python3-pil"' >&2
    exit 1
  fi
  # Extract into a scratch directory first, so a bad zip doesn't
  # leave images/ half replaced. Replacing (not merging) images/ keeps
  # old images from lingering when Google renumbers them.
  unzip -q "$zip" 'images/*' -d "$work"
  # The <img> tags in the zip's HTML give each image's alt text (the
  # only key that's the same in Finding.md), file name, and size.
  unzip -p "$zip" '*.html' | { grep -o '<img[^>]*>' || true; } > "$work/imgtags"
  mkdir "$work/embedded"
  awk_opts=(-v "imgtags=$work/imgtags" -v "renames=$work/renames"
            -v "embedded=$work/embedded" -v "keeps=$work/keeps" -v "zipname=$zip")
fi

awk "${awk_opts[@]}" -f clean-finding.awk Finding.md > Finding.md.new

if [ -f "$zip" ]; then
  # Give each image the name clean-finding.awk made from its alt text
  # (Google's imageN.png names are neither meaningful nor stable).
  # Move into a fresh directory, so that a new name that happens to
  # equal another image's old name can't clobber it.
  mkdir "$work/renamed"
  while IFS=$'\t' read -r old new; do
    mv "$work/$old" "$work/renamed/${new#images/}"
  done < "$work/renames"
  # Anything in the zip the HTML doesn't mention keeps its name.
  mv -n "$work"/images/* "$work/renamed/" 2>/dev/null || true

  # Images that aren't in the zip (clean-finding.awk warned about each
  # one): decode the copies embedded in Finding.md, and keep the
  # originals of existing images that earlier runs made that way.
  for f in "$work"/embedded/*.b64; do
    [ -e "$f" ] || continue
    b="${f##*/}"
    base64 -d < "$f" > "$work/renamed/${b%.b64}"
  done
  if [ -f "$work/keeps" ]; then
    while read -r f; do
      # f is a served copy, images/NAME.EXT; its original is
      # images-originals/NAME.* (or f itself, if it predates
      # images-originals/).
      name="${f#images/}"
      found=
      for o in images-originals/"${name%.*}".*; do
        if [ -f "$o" ]; then cp "$o" "$work/renamed/"; found=1; fi
      done
      if [ -z "$found" ] && [ -f "$f" ]; then cp "$f" "$work/renamed/$name"; fi
    done < "$work/keeps"
  fi

  # Make the served copies, and point Finding.md at them. Each
  # "(images/ORIGINAL)" becomes "(images/SERVED)"; a reference to a
  # kept image already names its served copy, so it stays as is.
  mkdir "$work/served"
  python3 -I compress-images.py "$work/renamed" "$work/served" > "$work/served-names"
  awk -v names="$work/served-names" '
    BEGIN {
      while ((getline line < names) > 0) {
        split(line, f, "\t")
        served["images/" f[1]] = "images/" f[2]
      }
    }
    {
      out = ""
      while (match($0, /\(images\/[^)]*\)/)) {
        path = substr($0, RSTART + 1, RLENGTH - 2)
        if (path in served) path = served[path]
        out = out substr($0, 1, RSTART) path ")"
        $0 = substr($0, RSTART + RLENGTH)
      }
      print out $0
    }' Finding.md.new > "$work/Finding.md.served"
  mv "$work/Finding.md.served" Finding.md.new

  # Every image Finding.md now uses must exist in the new images/.
  grep -o '(images/[^)]*)' Finding.md.new | tr -d '()' | while read -r f; do
    if [ ! -f "$work/served/${f#images/}" ]; then
      echo "cleanup-markdown: $f is in Finding.md but not in $zip" >&2
      exit 1
    fi
  done
  rm -rf images images-originals
  mv "$work/renamed" images-originals
  mv "$work/served" images
fi

mv Finding.md.new Finding.md
