#!/bin/bash
# Generate this website's HTML pages from the current Finding.md.
# Finding.md should already be clean (run cleanup-markdown first if
# you just downloaded it from Google Docs; a committed Finding.md
# already is). Long-term, this is meant to run only when the website
# itself is built/deployed, so the generated HTML need not be
# committed to the repo at all.

# SPDX-FileCopyrightText: OpenSSF project contributors
# SPDX-License-Identifier: MIT

set -e
set -o pipefail

# Generate the chunked HTML, right in this directory (no sections/
# subdirectory), so URLs stay flat.

# Clean up old chunks. Safe because only generated chunks use ".html"
# here: source/config files in this directory are .md/.awk/.js/.htm,
# or extensionless.
rm -f *.html

# pandoc's chunkedhtml writer insists on creating its output
# directory itself (it errors out if the directory already exists,
# and treats a dot-prefixed name as a zip-archive target instead of
# a directory), so it can't write straight into ".". Build into a
# scratch directory instead, then move the chunks up into place.
rm -fr chunks-tmp
#
# extract-title.awk feeds pandoc via stdin instead of a filename
# argument: it turns the leading title/byline/abstract block into
# YAML front matter (so it lands on index.html next to the table of
# contents, instead of becoming its own separate page), but only in
# what's piped to pandoc here; it never touches Finding.md itself.
#
# simple.min.css is vendored (not loaded from a CDN at page-load
# time): see README.md for why, its source/version, and how to check
# for and apply updates.
awk -f extract-title.awk Finding.md | \
pandoc -f markdown+raw_html+pipe_tables+autolink_bare_uris+strikeout \
  - \
  -t chunkedhtml --split-level=2 --toc -o chunks-tmp \
  --template=TEMPLATE.htm --chunk-template="%i.html" \
  --css="simple.min.css" \
  --metadata-file=metadata.yaml \
  --wrap=none \
  --number-sections \

# pandoc also copies the images Finding.md refers to (images/, from
# Finding.zip via cleanup-markdown) into its output. That copy is
# byte-identical to the committed ./images, which stays put, so drop it.
rm -fr chunks-tmp/images

mv chunks-tmp/* .
rmdir chunks-tmp

# index.html's own title is "TOC": metadata.yaml sets it that way so
# every OTHER page's Up/Previous/Top links back to it stay short (see
# metadata.yaml for why). But index.html itself should show the real
# title, not "TOC": patch it here, in both the <title> tag and the
# on-page heading. --wrap=none above keeps every tag on one line, so
# this is a plain single-line substitution: no need to reassemble
# text pandoc wrapped across several lines.
subtitle=$(grep -o '<p class="subtitle">.*</p>' index.html | sed -e 's/<p class="subtitle">//' -e 's/<\/p>//')
awk -v subtitle="$subtitle" '
/<h1 class="title">TOC<\/h1>/ { next }
{ sub(/TOC<\/title>/, subtitle "</title>") }
/<p class="subtitle">/ { sub(/<p class="subtitle">.*<\/p>/, "<h1 class=\"title\">" subtitle "</h1>") }
{ print }
' index.html > index.html.new
mv index.html.new index.html

echo
echo 'Commit with "git add -A -- *.html images/'
echo '"or a new file can end up linked from the document but'
echo 'never actually committed. The pathspec avoids sweeping up'
echo 'unrelated untracked files sitting in this same directory.'
